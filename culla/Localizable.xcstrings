          }
        }
      }
    },
    "Culla helps you sort your photo library one swipe at a time. Let's take a quick tour.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla hilft dir, deine Fotomediathek Wisch für Wisch zu sortieren. Machen wir eine kurze Tour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla te ayuda a ordenar tu fototeca deslizando una foto a la vez. Hagamos un recorrido rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla vous aide à trier votre photothèque un balayage à la fois. Faisons un tour rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla ti aiuta a smistare la tua libreria foto uno swipe alla volta. Facciamo un rapido tour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cullaはスワイプひとつで写真ライブラリを仕分けできます。簡単なツアーを始めましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Culla ajuda você a classificar sua fototeca um deslize de cada vez. Vamos fazer um tour rápido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla 帮你一次一滑地整理照片图库。来快速了解一下吧。"
          }
        }
      }
    },
    "Culla needs access to your photo library to organize your photos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla benötigt Zugriff auf deine Fotomediathek, um deine Fotos zu organisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla necesita acceso a tu fototeca para organizar tus fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla a besoin d'accéder à votre photothèque pour organiser vos photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla ha bisogno di accedere alla tua libreria foto per organizzare le tue foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を整理するには、Cullaが写真ライブラリにアクセスする必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Culla precisa de acesso à sua fototeca para organizar suas fotos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla 需要访问你的照片图库来整理照片。"
          }
        }
      }
    },
