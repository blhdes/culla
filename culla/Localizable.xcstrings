    "Tap + to create a new gallery, or use the menu to import an existing iPhone album.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf +, um eine neue Galerie zu erstellen, oder importiere über das Menü ein vorhandenes iPhone-Album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para crear una nueva galería o usa el menú para importar un álbum existente del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
