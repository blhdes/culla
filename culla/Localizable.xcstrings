    "Free for 7 days, then %@%@. Cancel anytime in Settings before the trial ends — you won't be charged if you cancel in time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage gratis, danach %1$@%2$@. Kündige jederzeit in den Einstellungen vor Ablauf der Testphase — bei rechtzeitiger Kündigung wird dir nichts berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Free for 7 days, then %1$@%2$@. Cancel anytime in Settings before the trial ends — you won't be charged if you cancel in time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante 7 días, luego %1$@%2$@. Cancela en Ajustes en cualquier momento antes de que termine la prueba: no se te cobrará si cancelas a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant 7 jours, puis %1$@%2$@. Annulez à tout moment dans Réglages avant la fin de l'essai — vous ne serez pas facturé si vous annulez à temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per 7 giorni, poi %1$@%2$@. Annulla in qualsiasi momento nelle Impostazioni prima della fine della prova: se annulli in tempo non ti verrà addebitato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間無料、その後%1$@%2$@。トライアル終了前に設定からいつでもキャンセルできます。期限内にキャンセルすれば課金されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis por 7 dias, depois %1$@%2$@. Cancele a qualquer momento nos Ajustes antes do fim do teste — você não será cobrado se cancelar a tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用 7 天,之后 %1$@%2$@。试用结束前可随时在设置中取消——及时取消不会扣费。"
          }
        }
      }
    },
