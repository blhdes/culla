    "Pick a date, tap Start, and swipe. Left to dismiss, right to sort, up to favourite, down to share.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Datum, tippe auf Start und wische. Links zum Verwerfen, rechts zum Sortieren, oben für Favoriten, unten zum Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una fecha, toca Empezar y desliza. Izquierda para descartar, derecha para clasificar, arriba para favorito, abajo para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une date, touchez Démarrer et balayez. À gauche pour écarter, à droite pour trier, en haut pour les favoris, en bas pour partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una data, tocca Inizia e scorri. Sinistra per scartare, destra per smistare, su per i preferiti, giù per condividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を選んでスタートをタップし、スワイプ。左で除外、右で仕分け、上でお気に入り、下で共有。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma data, toque em Iniciar e deslize. Esquerda para descartar, direita para classificar, cima para favoritar, baixo para compartilhar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日期,点按开始,然后滑动。左滑忽略,右滑整理,上滑收藏,下滑分享。"
          }
        }
      }
    },
