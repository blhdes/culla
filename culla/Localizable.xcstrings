    "Open any gallery from the list. Inside, tap the small color circle at the top to give it a neon color.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Galerie aus der Liste. Tippe darin oben auf den kleinen Farbkreis, um ihr eine Neonfarbe zu geben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cualquier galería de la lista. Dentro, toca el pequeño círculo de color de arriba para darle un color neón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une galerie de la liste. À l'intérieur, touchez le petit cercle de couleur en haut pour lui donner une couleur néon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una galleria dall'elenco. All'interno, tocca il cerchietto colorato in alto per darle un colore neon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストからギャラリーを開き、上部の小さなカラーサークルをタップしてネオンカラーを設定しましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra qualquer galeria da lista. Dentro, toque no pequeno círculo de cor no topo para dar a ela uma cor neon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从列表中打开任意影集,点按顶部的小色圈为它设置霓虹色。"
          }
        }
      }
    },
