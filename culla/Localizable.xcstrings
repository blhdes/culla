    "Culla can only see photos you've selected. Add more or grant full access for the best experience.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla sieht nur die von dir ausgewählten Fotos. Füge mehr hinzu oder erlaube vollen Zugriff für das beste Erlebnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla solo puede ver las fotos que has seleccionado. Añade más o concede acceso completo para una mejor experiencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla ne voit que les photos que vous avez sélectionnées. Ajoutez-en plus ou accordez un accès complet pour une meilleure expérience."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla può vedere solo le foto che hai selezionato. Aggiungine altre o concedi l'accesso completo per un'esperienza migliore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cullaは選択された写真のみ表示できます。さらに追加するか、フルアクセスを許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Culla só pode ver as fotos que você selecionou. Adicione mais ou conceda acesso total para a melhor experiência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla 只能查看你选择的照片。添加更多或授予完整访问权限以获得最佳体验。"
          }
        }
      }
    },
    "Culla for %lld min": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Culla für %lld Min."
          }
        },
        "es": {
