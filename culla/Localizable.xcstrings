    "Sort smarter. Keep what matters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere smarter. Behalte, was zählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clasifica mejor. Conserva lo que importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Triez plus intelligemment. Gardez l'essentiel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smista in modo più smart. Conserva ciò che conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "賢く仕分けて、大切なものだけを。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Classifique melhor. Guarde o que importa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更聪明地整理,留下真正重要的。"
          }
        }
      }
    },
    "Sorted photos are removed from the source album.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortierte Fotos werden aus dem Quellalbum entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos clasificadas se eliminan del álbum de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos triées sont retirées de l'album source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto smistate vengono rimosse dall'album di origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕分けた写真は元のアルバムから削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos classificadas são removidas do álbum de origem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理后的照片会从源相册中移除。"
          }
        }
      }
    },
    "Sorted photos stay in the source album too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortierte Fotos bleiben auch im Quellalbum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos clasificadas también permanecen en el álbum de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos triées restent aussi dans l'album source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto smistate restano anche nell'album di origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕分けた写真は元のアルバムにも残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos classificadas também permanecem no álbum de origem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理后的照片也会保留在源相册中。"
          }
        }
      }
    },
    "Spin the wheel to choose a date. Culla shows your photos from that day. Tap the wheel to open a full calendar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehe das Rad, um ein Datum zu wählen. Culla zeigt deine Fotos von diesem Tag. Tippe auf das Rad für den vollständigen Kalender."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la rueda para elegir una fecha. Culla muestra tus fotos de ese día. Toca la rueda para abrir el calendario completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites tourner la roue pour choisir une date. Culla affiche vos photos de ce jour. Touchez la roue pour ouvrir le calendrier complet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la rotella per scegliere una data. Culla mostra le tue foto di quel giorno. Tocca la rotella per aprire il calendario completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイールを回して日付を選択。Cullaがその日の写真を表示します。ホイールをタップするとカレンダーが開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a roda para escolher uma data. O Culla mostra suas fotos daquele dia. Toque na roda para abrir o calendário completo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转动转盘选择日期,Culla 会显示那天的照片。点按转盘可打开完整日历。"
          }
        }
      }
    },
