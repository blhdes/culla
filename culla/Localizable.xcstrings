{
  "sourceLanguage": "en",
  "strings": {
    "—": {
      "shouldTranslate": false
    },
    "·": {
      "shouldTranslate": false
    },
    "\"Remove from Culla\" just hides it here — your iPhone album stays intact.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus Culla entfernen“ blendet sie nur hier aus — dein iPhone-Album bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Quitar de Culla» solo la oculta aquí: tu álbum del iPhone queda intacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Retirer de Culla » la masque uniquement ici — votre album iPhone reste intact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Rimuovi da Culla» la nasconde solo qui: il tuo album iPhone resta intatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Cullaから削除」はここで非表示にするだけで、iPhoneのアルバムはそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Remover do Culla” apenas a oculta aqui — seu álbum do iPhone permanece intacto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“从 Culla 中移除”只会在此处隐藏它——你的 iPhone 相册保持不变。"
          }
        }
      }
    },
    "* Photos already sorted into other galleries will also appear here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "* Fotos, die bereits in andere Galerien sortiert wurden, erscheinen ebenfalls hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "* Las fotos ya clasificadas en otras galerías también aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "* Les photos déjà triées dans d'autres galeries apparaîtront aussi ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "* Anche le foto già smistate in altre gallerie appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "* 他のギャラリーに仕分け済みの写真もここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "* Fotos já classificadas em outras galerias também aparecerão aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "* 已整理到其他影集的照片也会显示在这里。"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld / %lld": {
